# ============================================================
#  SAFE-HAVEN — Frontend Environment Variables
#  Copy this file to .env and fill in your values.
# ============================================================

# Deployed Soroban contract ID (from `stellar contract deploy`)
VITE_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4

# Stellar network passphrase
# Testnet:  "Test SDF Network ; September 2015"
# Mainnet:  "Public Global Stellar Network ; September 2015"
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Soroban RPC endpoint
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://soroban.stellar.org
VITE_RPC_URL=https://soroban-testnet.stellar.org

# Horizon endpoint (for account queries)
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar Expert explorer base URL
VITE_EXPLORER_URL=https://stellar.expert/explorer/testnet
